# Sentinel-Recon: parallel port scanner + banner grabber
# Usage examples:
#   go run ./cmd/aegisx-recon -target scanme.example.com -start 1 -end 1024
#   go run ./cmd/aegisx-recon -target 10.0.0.5 -format json -out ./report.json
FROM golang:1.22-alpine AS build

WORKDIR /src
COPY proto /src/proto
COPY sentinel-recon /src/sentinel-recon
RUN cd sentinel-recon && go mod download

# Regenerate protobuf bindings inside the image so no host tooling is required.
RUN apk add --no-cache protobuf protoc && \
    go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.34.2 && \
    go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.4.0 && \
    cd /src/proto && \
    PATH="$PATH:/go/bin" protoc --go_out=gen/go --go_opt=paths=source_relative \
      --go-grpc_out=gen/go --go-grpc_opt=paths=source_relative aegisx.proto && \
    cd /src/sentinel-recon && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/aegisx-recon ./cmd/aegisx-recon

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=build /out/aegisx-recon /app/aegisx-recon
ENV GOTRACEBACK=all
ENTRYPOINT ["/app/aegisx-recon"]
