# AegisX docker-compose environment (copy to .env)
# Rename this file to `.env` to use with `docker compose`.

# PhishGuard gateway
PHISHGUARD_HTTP_PORT=8080      # Web UI / REST / WebSocket (Control Center connects here)
PHISHGUARD_GRPC_PORT=50051     # decoy + recon gRPC intake

# ShadowPot decoy listeners
DECOY_HTTP_PORT=8080
DECOY_SSH_PORT=2222
DECOY_MYSQL_PORT=3306
DECOY_REDIS_PORT=6379
DECOY_POSTGRES_PORT=5432
DECOY_TELNET_PORT=23
SHADOWPOT_GRPC_PORT=50053      # SOAR command plane (PhishGuard -> ShadowPot blocks)
AEGISX_SHADOWPOT_TOKEN=        # optional shared bearer token securing the command plane
                               #   (set to a long random value in production; empty = dev)

# ShadowPot capture + IP-banning engine
PCAP_ENABLED=true
BAN_ENABLED=true
BAN_THRESHOLD=3                # malicious events within window before auto-ban
BAN_WINDOW_SECONDS=300
BAN_DURATION_SECONDS=3600
BAN_BACKEND=auto               # auto | nftables | iptables | journal (dry-run)

# ZeroTrust FIM
FIM_WATCH_DIR=/etc             # host directory to integrity-protect
FIM_RUST_LOG=info
# FIM_FEATURES="ebpf"          # in-kernel execve tracepoint (CAP_BPF/PERFMON + tracefs)
# FIM_FEATURES="yara"          # process-memory YARA scanner (CAP_SYS_PTRACE)
# FIM_FEATURES="--features 'ebpf yara ffi'"

# OSINT / Threat Intelligence (one or more keys; unset feeds are skipped)
ABUSEIPDB_KEY=                # optional AbuseIPDB API v2 key
VT_KEY=                       # optional VirusTotal API v3 key
OTX_BASE=https://otx.alienvault.com/api/v1
THREATFOX_URL=https://threatfox-api.abuse.ch/api/v1/