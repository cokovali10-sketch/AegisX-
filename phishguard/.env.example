# AegisX PhishGuard AI - environment configuration
# Copy to .env and adjust.

# FastAPI
AEGISX_HTTP_HOST=0.0.0.0
AEGISX_HTTP_PORT=8080

# gRPC gateway
AEGISX_GRPC_PORT=50051

# Vector store (ChromaDB) - optional
AEGISX_CHROMA_PATH=/var/lib/aegisx/chroma
AEGISX_VECTORSTORE_ENABLED=true

# OSINT feeds
# AbuseIPDB: https://www.abuseipdb.com/account/api
AEGISX_ABUSEIPDB_KEY=
AEGISX_ABUSEIPDB_URL=https://api.abuseipdb.com/api/v2/check

# Upstream decoy configuration (used only for dynamic port toggles)
AEGISX_DECOYS_HTTP_PORTS=8080
AEGISX_DECOYS_SSH_PORTS=2222
AEGISX_DECOYS_MYSQL_PORTS=3306
